---
import Layout from '../../../layouts/Layout.astro';

const { code } = Astro.params;
---

<Layout title="Unir-se a grup">
  <div id="join-app" data-code={code} class="min-h-screen flex items-center justify-center px-4"></div>

  <script>
    import { createElement } from 'react';
    import { createRoot } from 'react-dom/client';
    import { JoinPage } from '../../../components/JoinPage';

    const container = document.getElementById('join-app');
    if (container) {
      const code = container.dataset.code;
      const root = createRoot(container);
      root.render(createElement(JoinPage, { code }));
    }
  </script>
</Layout>
