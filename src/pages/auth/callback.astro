---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Autenticant...">
  <div class="min-h-screen flex items-center justify-center bg-[var(--color-sand)]">
    <div class="text-center max-w-sm mx-auto px-4">
      <div class="relative w-16 h-16 mx-auto mb-4">
        <div class="absolute inset-0 rounded-full bg-[var(--color-sun)] animate-pulse" />
        <div class="absolute inset-2 rounded-full bg-[var(--color-sun-light)] animate-pulse" style="animation-delay: 150ms" />
        <div class="absolute inset-4 rounded-full bg-[var(--color-cream)]" />
      </div>
      <p class="text-[var(--color-ink-muted)] mb-2" id="status-text">Autenticant...</p>
      <p class="text-[var(--color-ink-muted)] text-sm opacity-0 transition-opacity duration-300" id="close-hint">
        Si ja has iniciat sessió a una altra pestanya, pots tancar aquesta.
      </p>
    </div>
  </div>

  <script>
    import { supabase } from '../../lib/supabase';

    const statusText = document.getElementById('status-text');

    // Show close hint after 3 seconds
    setTimeout(() => {
      const hint = document.getElementById('close-hint');
      if (hint) hint.style.opacity = '1';
    }, 3000);

    async function handleCallback() {
      try {
        // Check for error in URL hash
        const hashParams = new URLSearchParams(window.location.hash.substring(1));
        const error = hashParams.get('error');
        const errorDescription = hashParams.get('error_description');

        if (error) {
          console.error('Auth error:', error, errorDescription);
          const errorMsg = encodeURIComponent(errorDescription || error);
          window.location.href = `/?error=${error}&message=${errorMsg}`;
          return;
        }

        // Check for tokens in hash (magic link)
        const accessToken = hashParams.get('access_token');
        const refreshToken = hashParams.get('refresh_token');

        if (accessToken && refreshToken) {
          if (statusText) statusText.textContent = 'Validant sessió...';

          const { error: sessionError } = await supabase.auth.setSession({
            access_token: accessToken,
            refresh_token: refreshToken,
          });

          if (sessionError) {
            console.error('Session error:', sessionError);
            window.location.href = '/?error=auth_failed';
            return;
          }

          // Session set successfully - redirect to home
          // The home page will check if profile setup is needed
          window.location.href = '/';
          return;
        }

        // Check for code in URL params (PKCE flow)
        const urlParams = new URLSearchParams(window.location.search);
        const code = urlParams.get('code');

        if (code) {
          if (statusText) statusText.textContent = 'Intercanviant codi...';

          const { error: codeError } = await supabase.auth.exchangeCodeForSession(code);

          if (codeError) {
            console.error('Code exchange error:', codeError);
            window.location.href = '/?error=auth_failed';
            return;
          }

          // Code exchanged successfully - redirect to home
          window.location.href = '/';
          return;
        }

        // No tokens or code - check if already authenticated
        const { data: { session } } = await supabase.auth.getSession();

        if (session) {
          // Already authenticated, go home
          window.location.href = '/';
        } else {
          // No session, go to login
          window.location.href = '/';
        }
      } catch (err) {
        console.error('Callback error:', err);
        window.location.href = '/?error=auth_failed';
      }
    }

    handleCallback();
  </script>
</Layout>
